# ==============================================================================
# UXSP .gitignore
# Canonical ignore rules for Python core, Rust native engine, and multi-platform SDKs
# ==============================================================================

# ── 1. Python (Core Engine & CLI) ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.dylib
*.dll
*.pyd

# Packaging & Distribution
.Python
build/
develop-eggs/
dist/
.dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
.python-version

# Testing & Coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.pytest_cache/
pytest_cache/
pytestdebug.log
.benchmarks/

# Linters, Formatting & Type Checkers
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pyre/
.pytype/

# ── 2. JavaScript / TypeScript SDK (sdks/js) ──────────────────────────────────
node_modules/
**/node_modules/
sdks/js/dist/
sdks/js/build/
sdks/js/coverage/
.npm/
pnpm-lock.yaml
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.tsbuildinfo

# Transient compiled test artifacts (in case tsc is run without outDir)
sdks/js/tests/*.js
sdks/js/tests/**/*.js
sdks/js/tests/*.js.map
sdks/js/tests/**/*.js.map
sdks/js/tests/*.d.ts
sdks/js/tests/**/*.d.ts
sdks/js/tests/*.d.ts.map
sdks/js/tests/**/*.d.ts.map

# ── 3. Cryptographic Keys, Secrets & Databases ────────────────────────────────
# Never commit private keys, secrets, local credentials or databases
*.pem
*.crt
*.key
*.pub
*.p12
*.pfx
*.uxsp
*.keys
local_keys/

# Database files
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm

# Environment variables
.env
.env.*
!.env.example
!.env.template

# ── 4. Logs & Temporary Output Files ──────────────────────────────────────────
*.log
*.tmp
*.temp
*.bak
*~
out.txt
coverage_report.txt

# ── 5. Operating System & Editor Files ───────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# ── 6. Antigravity & AI Agent Artifacts ──────────────────────────────────────
.gemini/
.antigravity/
